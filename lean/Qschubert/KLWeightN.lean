import Qschubert.KLWave4

/-!
# Truncated weights

`W_n = (X₀^{-γ} + 1/n)⁻¹` with `X₀ = cosh d(i, ·)` satisfies `WaveW3` with `ρ = γ` and `K` independent of `n` (`waveW3_Wn`). The derivatives close
on the algebra generated by `ξ = x/X₀`, `υ = y/X₀`, `p = X₀^{-γ} W_n`: `X W = W γ ξ p`, `Y W = W γ (υ - 1) p`, `Z p = -(1 - p) a_Z`.

`Ak k f c`: `f` is smooth on `ℍ` and every word of length `≤ k` in `X, Y` applied to `f` is bounded by `c`.
-/

namespace Qschubert

open MeasureTheory Filter Topology Complex Set
open scoped ContDiff

lemma isOpen_up : IsOpen {w : ℂ | 0 < w.im} := isOpen_lt continuous_const Complex.continuous_im

lemma ev_up {w : ℂ} (hw : 0 < w.im) : ∀ᶠ u in 𝓝 w, 0 < u.im := isOpen_up.mem_nhds hw

/-- Every word of length `≤ k` is bounded by `c` on `ℍ`. -/
inductive Ak : ℕ → (ℂ → ℝ) → ℝ → Prop
  | zero {f : ℂ → ℝ} {c : ℝ} (s : ∀ w : ℂ, 0 < w.im → ContDiffAt ℝ ∞ f w) (b : ∀ w : ℂ, 0 < w.im → |f w| ≤ c) : Ak 0 f c
  | step {k : ℕ} {f : ℂ → ℝ} {c : ℝ} (h0 : Ak 0 f c) (hX : Ak k (vfR 1 f) c) (hY : Ak k (vfR Complex.I f) c) : Ak (k + 1) f c

namespace Ak

variable {k : ℕ} {f g : ℂ → ℝ} {c d : ℝ}

lemma z0 (h : Ak (k + 1) f c) : Ak 0 f c := by cases h with | step h0 _ _ => exact h0
lemma xs (h : Ak (k + 1) f c) : Ak k (vfR 1 f) c := by cases h with | step _ hX _ => exact hX
lemma ys (h : Ak (k + 1) f c) : Ak k (vfR Complex.I f) c := by cases h with | step _ _ hY => exact hY
lemma sm0 (h : Ak 0 f c) : ∀ w : ℂ, 0 < w.im → ContDiffAt ℝ ∞ f w := by cases h with | zero s _ => exact s
lemma bd0 (h : Ak 0 f c) : ∀ w : ℂ, 0 < w.im → |f w| ≤ c := by cases h with | zero _ b => exact b

lemma base (h : Ak k f c) : Ak 0 f c := by
  cases k with
  | zero => exact h
  | succ k => exact h.z0

lemma smooth (h : Ak k f c) : ∀ w : ℂ, 0 < w.im → ContDiffAt ℝ ∞ f w := h.base.sm0
lemma bd (h : Ak k f c) : ∀ w : ℂ, 0 < w.im → |f w| ≤ c := h.base.bd0
lemma diff (h : Ak k f c) {w : ℂ} (hw : 0 < w.im) : DifferentiableAt ℝ f w := (h.smooth w hw).differentiableAt (by simp)

lemma pred (h : Ak (k + 1) f c) : Ak k f c := by
  induction k generalizing f with
  | zero => exact h.z0
  | succ k ih => exact .step h.z0 (ih h.xs) (ih h.ys)

lemma mono0 (hcd : c ≤ d) (h : Ak 0 f c) : Ak 0 f d := .zero h.sm0 fun w hw => (h.bd0 w hw).trans hcd

lemma mono (hcd : c ≤ d) (h : Ak k f c) : Ak k f d := by
  induction k generalizing f with
  | zero => exact mono0 hcd h
  | succ k ih => exact .step (mono0 hcd h.z0) (ih h.xs) (ih h.ys)

lemma congr0 (h : ∀ w : ℂ, 0 < w.im → f w = g w) (hA : Ak 0 f c) : Ak 0 g c :=
  .zero (fun w hw => (hA.sm0 w hw).congr_of_eventuallyEq ((ev_up hw).mono fun u hu => (h u hu).symm))
    fun w hw => by rw [← h w hw]; exact hA.bd0 w hw

lemma congr (h : ∀ w : ℂ, 0 < w.im → f w = g w) (hA : Ak k f c) : Ak k g c := by
  induction k generalizing f g with
  | zero => exact congr0 h hA
  | succ k ih =>
    exact .step (congr0 h hA.z0) (ih (fun w hw => vfR_congr ((ev_up hw).mono fun u hu => h u hu) _) hA.xs)
      (ih (fun w hw => vfR_congr ((ev_up hw).mono fun u hu => h u hu) _) hA.ys)

lemma const0 (a : ℝ) : Ak 0 (fun _ => a) |a| := .zero (fun _ _ => contDiffAt_const) fun _ _ => le_rfl

lemma vfR_const (v : ℂ) (a : ℝ) : vfR v (fun _ : ℂ => a) = fun _ => 0 := by
  funext w; simp [vfR]

lemma zeroF (k : ℕ) : Ak k (fun _ => (0 : ℝ)) 0 := by
  induction k with
  | zero => simpa using const0 0
  | succ k ih =>
    have h0 : Ak 0 (fun _ => (0 : ℝ)) 0 := by simpa using const0 0
    refine .step h0 ?_ ?_ <;> rw [vfR_const] <;> exact ih

lemma const (k : ℕ) (a : ℝ) : Ak k (fun _ => a) |a| := by
  cases k with
  | zero => exact const0 a
  | succ k =>
    refine .step (const0 a) ?_ ?_ <;> rw [vfR_const] <;> exact (zeroF k).mono (abs_nonneg a)

lemma vfR_add_at {f g : ℂ → ℝ} {w : ℂ} (hf : DifferentiableAt ℝ f w) (hg : DifferentiableAt ℝ g w) (v : ℂ) :
    vfR v (fun u => f u + g u) w = vfR v f w + vfR v g w := by
  rw [vfR_of_hasFDerivAt (hf.hasFDerivAt.fun_add hg.hasFDerivAt) v]
  simp only [vfR, ContinuousLinearMap.add_apply]
  ring

lemma vfR_mul_at {f g : ℂ → ℝ} {w : ℂ} (hf : DifferentiableAt ℝ f w) (hg : DifferentiableAt ℝ g w) (v : ℂ) :
    vfR v (fun u => f u * g u) w = vfR v f w * g w + f w * vfR v g w := by
  rw [vfR_of_hasFDerivAt (hf.hasFDerivAt.fun_mul hg.hasFDerivAt) v]
  simp only [vfR, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
  ring

lemma add0 (hf : Ak 0 f c) (hg : Ak 0 g d) : Ak 0 (fun u => f u + g u) (c + d) :=
  .zero (fun w hw => (hf.sm0 w hw).add (hg.sm0 w hw)) fun w hw => (abs_add_le _ _).trans (add_le_add (hf.bd0 w hw) (hg.bd0 w hw))

lemma add (hf : Ak k f c) (hg : Ak k g d) : Ak k (fun u => f u + g u) (c + d) := by
  induction k generalizing f g with
  | zero => exact add0 hf hg
  | succ k ih =>
    refine .step (add0 hf.z0 hg.z0) ?_ ?_
    · exact (ih hf.xs hg.xs).congr fun w hw => (vfR_add_at (hf.diff hw) (hg.diff hw) 1).symm
    · exact (ih hf.ys hg.ys).congr fun w hw => (vfR_add_at (hf.diff hw) (hg.diff hw) Complex.I).symm

lemma mul0 (hc : 0 ≤ c) (hf : Ak 0 f c) (hg : Ak 0 g d) : Ak 0 (fun u => f u * g u) (c * d) :=
  .zero (fun w hw => (hf.sm0 w hw).mul (hg.sm0 w hw)) fun w hw => by
    rw [abs_mul]; exact mul_le_mul (hf.bd0 w hw) (hg.bd0 w hw) (abs_nonneg _) hc

lemma mul (hc : 0 ≤ c) (hd : 0 ≤ d) (hf : Ak k f c) (hg : Ak k g d) : Ak k (fun u => f u * g u) (2 ^ k * c * d) := by
  induction k generalizing f g with
  | zero => simpa using mul0 hc hf hg
  | succ k ih =>
    have e : (2 : ℝ) ^ k * c * d + 2 ^ k * c * d = 2 ^ (k + 1) * c * d := by ring
    have h2k : (1 : ℝ) ≤ 2 ^ (k + 1) := one_le_pow₀ (by norm_num)
    have hcd : 0 ≤ c * d := mul_nonneg hc hd
    refine .step (mono0 ?_ (mul0 hc hf.z0 hg.z0)) ?_ ?_
    · nlinarith
    · have h := (ih hf.xs hg.pred).add (ih hf.pred hg.xs)
      rw [e] at h
      exact h.congr fun w hw => (vfR_mul_at (hf.diff hw) (hg.diff hw) 1).symm
    · have h := (ih hf.ys hg.pred).add (ih hf.pred hg.ys)
      rw [e] at h
      exact h.congr fun w hw => (vfR_mul_at (hf.diff hw) (hg.diff hw) Complex.I).symm

end Ak

/-- A family bounded uniformly in `n`. -/
def UA (k : ℕ) (F : ℕ → ℂ → ℝ) : Prop := ∃ c : ℝ, 0 ≤ c ∧ ∀ n : ℕ, 0 < n → Ak k (F n) c

namespace UA

variable {k : ℕ} {F G : ℕ → ℂ → ℝ}

lemma pred (h : UA (k + 1) F) : UA k F := by
  obtain ⟨c, hc, h⟩ := h
  exact ⟨c, hc, fun n hn => (h n hn).pred⟩

lemma xs (h : UA (k + 1) F) : UA k fun n => vfR 1 (F n) := by
  obtain ⟨c, hc, h⟩ := h
  exact ⟨c, hc, fun n hn => (h n hn).xs⟩

lemma ys (h : UA (k + 1) F) : UA k fun n => vfR Complex.I (F n) := by
  obtain ⟨c, hc, h⟩ := h
  exact ⟨c, hc, fun n hn => (h n hn).ys⟩

lemma step (h0 : UA 0 F) (hX : UA k fun n => vfR 1 (F n)) (hY : UA k fun n => vfR Complex.I (F n)) : UA (k + 1) F := by
  obtain ⟨c0, hc0, h0⟩ := h0
  obtain ⟨c1, hc1, h1⟩ := hX
  obtain ⟨c2, hc2, h2⟩ := hY
  refine ⟨c0 + c1 + c2, by positivity, fun n hn => .step (Ak.mono (by linarith) (h0 n hn)) (Ak.mono (by linarith) (h1 n hn))
    (Ak.mono (by linarith) (h2 n hn))⟩

lemma congr (h : ∀ n : ℕ, 0 < n → ∀ w : ℂ, 0 < w.im → F n w = G n w) (hA : UA k F) : UA k G := by
  obtain ⟨c, hc, hA⟩ := hA
  exact ⟨c, hc, fun n hn => (hA n hn).congr (h n hn)⟩

lemma const (k : ℕ) (a : ℝ) : UA k fun _ _ => a := ⟨|a|, abs_nonneg a, fun _ _ => Ak.const k a⟩

lemma add (hF : UA k F) (hG : UA k G) : UA k fun n u => F n u + G n u := by
  obtain ⟨c, hc, h1⟩ := hF
  obtain ⟨d, hd, h2⟩ := hG
  exact ⟨c + d, by positivity, fun n hn => (h1 n hn).add (h2 n hn)⟩

lemma mul (hF : UA k F) (hG : UA k G) : UA k fun n u => F n u * G n u := by
  obtain ⟨c, hc, h1⟩ := hF
  obtain ⟨d, hd, h2⟩ := hG
  exact ⟨2 ^ k * c * d, by positivity, fun n hn => Ak.mul hc hd (h1 n hn) (h2 n hn)⟩

end UA

/-- `X₀^{-γ}`. -/
noncomputable def tauG (γ : ℝ) (w : ℂ) : ℝ := hF w ^ γ

/-- `W_n`. -/
noncomputable def Wn (γ : ℝ) (n : ℕ) (w : ℂ) : ℝ := (tauG γ w + (n : ℝ)⁻¹)⁻¹

/-- `X₀^{-γ} W_n`. -/
noncomputable def pN (γ : ℝ) (n : ℕ) (w : ℂ) : ℝ := tauG γ w * Wn γ n w

section gens

variable (γ : ℝ) (n : ℕ) (hn : 0 < n) {w : ℂ} (hw : 0 < w.im)

lemma tauG_pos (hw : 0 < w.im) : 0 < tauG γ w := Real.rpow_pos_of_pos (hF_pos hw) γ

include hn in
lemma inv_n_pos : 0 < (n : ℝ)⁻¹ := inv_pos.2 (by exact_mod_cast hn)

include hn in
lemma sum_pos (hw : 0 < w.im) : 0 < tauG γ w + (n : ℝ)⁻¹ := add_pos (tauG_pos γ hw) (inv_n_pos n hn)

include hn in
lemma Wn_pos (hw : 0 < w.im) : 0 < Wn γ n w := inv_pos.2 (sum_pos γ n hn hw)

include hn in
lemma Wn_le (hw : 0 < w.im) : Wn γ n w ≤ n := by
  have h0 : (0 : ℝ) < n := by exact_mod_cast hn
  have h1 := tauG_pos γ hw
  unfold Wn
  calc (tauG γ w + (n : ℝ)⁻¹)⁻¹ ≤ ((n : ℝ)⁻¹)⁻¹ := inv_anti₀ (inv_pos.2 h0) (by linarith)
    _ = n := inv_inv _

include hn in
lemma pN_pos (hw : 0 < w.im) : 0 < pN γ n w := mul_pos (tauG_pos γ hw) (Wn_pos γ n hn hw)

include hn in
lemma pN_eq (hw : 0 < w.im) : pN γ n w = 1 - (n : ℝ)⁻¹ * Wn γ n w := by
  have h := sum_pos γ n hn hw
  have h1 : (tauG γ w + (n : ℝ)⁻¹) * Wn γ n w = 1 := mul_inv_cancel₀ h.ne'
  unfold pN
  linear_combination h1

include hn in
lemma pN_le (hw : 0 < w.im) : pN γ n w ≤ 1 := by
  rw [pN_eq γ n hn hw]
  have := mul_pos (inv_n_pos n hn) (Wn_pos γ n hn hw)
  linarith

lemma contDiffAt_tauG (hw : 0 < w.im) : ContDiffAt ℝ ∞ (tauG γ) w :=
  contDiff_hF.contDiffAt.rpow_const_of_ne (hF_pos hw).ne'

include hn in
lemma contDiffAt_Wn (hw : 0 < w.im) : ContDiffAt ℝ ∞ (Wn γ n) w :=
  ((contDiffAt_tauG γ hw).add contDiffAt_const).inv (sum_pos γ n hn hw).ne'

include hn in
lemma contDiffAt_pN (hw : 0 < w.im) : ContDiffAt ℝ ∞ (pN γ n) w :=
  (contDiffAt_tauG γ hw).mul (contDiffAt_Wn γ n hn hw)

/-- `Z τ = γ τ (Z h)/h`. -/
lemma vfR_tauG (v : ℂ) (hw : 0 < w.im) : vfR v (tauG γ) w = γ * tauG γ w * (vfR v hF w / hF w) := by
  have hh : HasFDerivAt hF (fderiv ℝ hF w) w := ((contDiff_hF.differentiable (by simp)) w).hasFDerivAt
  have h := (Real.hasDerivAt_rpow_const (p := γ) (Or.inl (hF_pos hw).ne')).comp_hasFDerivAt w hh
  have e : vfR v (tauG γ) w = w.im * (((γ * hF w ^ (γ - 1)) • fderiv ℝ hF w) v) := vfR_of_hasFDerivAt h v
  rw [e, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hpos := hF_pos hw
  have e2 : hF w ^ (γ - 1) = hF w ^ γ / hF w := Real.rpow_sub_one hpos.ne' γ
  simp only [vfR, tauG]
  rw [e2]
  field_simp

lemma vfR_tauG_one (hw : 0 < w.im) : vfR 1 (tauG γ) w = -(γ * tauG γ w * xiF w) := by
  rw [vfR_tauG γ 1 hw, vfR_hF_one]
  have := (hF_pos hw).ne'
  field_simp

lemma vfR_tauG_I (hw : 0 < w.im) : vfR Complex.I (tauG γ) w = γ * tauG γ w * (1 - upF w) := by
  rw [vfR_tauG γ Complex.I hw, vfR_hF_I]
  have := (hF_pos hw).ne'
  field_simp

include hn in
lemma vfR_Wn (v : ℂ) (hw : 0 < w.im) : vfR v (Wn γ n) w = -(Wn γ n w ^ 2 * vfR v (tauG γ) w) := by
  have hs := sum_pos γ n hn hw
  have hd : DifferentiableAt ℝ (tauG γ) w := (contDiffAt_tauG γ hw).differentiableAt (by simp)
  have h1 : HasFDerivAt (fun u => tauG γ u + (n : ℝ)⁻¹) (fderiv ℝ (tauG γ) w) w := hd.hasFDerivAt.add_const _
  have h := (hasDerivAt_inv hs.ne').comp_hasFDerivAt w h1
  have e : vfR v (Wn γ n) w = w.im * ((-((tauG γ w + (n : ℝ)⁻¹) ^ 2)⁻¹) • fderiv ℝ (tauG γ) w) v := vfR_of_hasFDerivAt h v
  rw [e, ContinuousLinearMap.smul_apply, smul_eq_mul]
  simp only [vfR, Wn]
  field_simp

/-- `aX = γ ξ p`. -/
noncomputable def aX (γ : ℝ) (n : ℕ) (w : ℂ) : ℝ := γ * (xiF w * pN γ n w)

/-- `aY = γ (υ - 1) p`. -/
noncomputable def aY (γ : ℝ) (n : ℕ) (w : ℂ) : ℝ := γ * ((upF w + -1) * pN γ n w)

include hn in
lemma vfR_Wn_one (hw : 0 < w.im) : vfR 1 (Wn γ n) w = Wn γ n w * aX γ n w := by
  rw [vfR_Wn γ n hn 1 hw, vfR_tauG_one γ hw]
  simp only [aX, pN]
  ring

include hn in
lemma vfR_Wn_I (hw : 0 < w.im) : vfR Complex.I (Wn γ n) w = Wn γ n w * aY γ n w := by
  rw [vfR_Wn γ n hn Complex.I hw, vfR_tauG_I γ hw]
  simp only [aY, pN]
  ring

include hn in
lemma vfR_pN_v (v : ℂ) (hw : 0 < w.im) : vfR v (pN γ n) w = -((n : ℝ)⁻¹ * vfR v (Wn γ n) w) := by
  have hev : pN γ n =ᶠ[𝓝 w] fun u => 1 + (-(n : ℝ)⁻¹) * Wn γ n u :=
    (ev_up hw).mono fun u hu => by rw [pN_eq γ n hn hu]; ring
  rw [vfR_congr hev]
  have hd : DifferentiableAt ℝ (Wn γ n) w := (contDiffAt_Wn γ n hn hw).differentiableAt (by simp)
  have h : HasFDerivAt (fun u => 1 + (-(n : ℝ)⁻¹) * Wn γ n u) ((-(n : ℝ)⁻¹) • fderiv ℝ (Wn γ n) w) w :=
    (hd.hasFDerivAt.const_mul _).const_add _
  rw [vfR_of_hasFDerivAt h v, ContinuousLinearMap.smul_apply, smul_eq_mul]
  simp only [vfR]
  ring

include hn in
lemma vfR_pN_one (hw : 0 < w.im) : vfR 1 (pN γ n) w = (pN γ n w + -1) * aX γ n w := by
  rw [vfR_pN_v γ n hn 1 hw, vfR_Wn_one γ n hn hw, pN_eq γ n hn hw]
  simp only [aX]
  rw [pN_eq γ n hn hw]
  ring

include hn in
lemma vfR_pN_I (hw : 0 < w.im) : vfR Complex.I (pN γ n) w = (pN γ n w + -1) * aY γ n w := by
  rw [vfR_pN_v γ n hn Complex.I hw, vfR_Wn_I γ n hn hw, pN_eq γ n hn hw]
  simp only [aY]
  rw [pN_eq γ n hn hw]
  ring

end gens

/-- **The generators are uniformly bounded with all words of length `≤ k`.** -/
theorem gens_A (γ : ℝ) (k : ℕ) :
    UA k (fun _ => xiF) ∧ UA k (fun _ => upF) ∧ UA k (pN γ) := by
  induction k with
  | zero =>
    refine ⟨⟨1, zero_le_one, fun _ _ => .zero (fun w _ => contDiff_xiF.contDiffAt) (fun w _ => abs_xiF_le w)⟩,
      ⟨2, by norm_num, fun _ _ => .zero (fun w _ => contDiff_upF.contDiffAt) (fun w _ => ?_)⟩,
      ⟨1, zero_le_one, fun n hn => .zero (fun w hw => contDiffAt_pN γ n hn hw) (fun w hw => ?_)⟩⟩
    · rw [abs_of_nonneg (upF_nonneg w)]; exact upF_le_two w
    · rw [abs_of_pos (pN_pos γ n hn hw)]; exact pN_le γ n hn hw
  | succ k ih =>
    obtain ⟨hx, hu, hp⟩ := ih
    have mone := UA.const k (-1)
    have hb0 : UA 0 (fun _ => xiF) ∧ UA 0 (fun _ => upF) ∧ UA 0 (pN γ) := by
      refine ⟨?_, ?_, ?_⟩
      · obtain ⟨c, hc, h⟩ := hx; exact ⟨c, hc, fun n hn => (h n hn).base⟩
      · obtain ⟨c, hc, h⟩ := hu; exact ⟨c, hc, fun n hn => (h n hn).base⟩
      · obtain ⟨c, hc, h⟩ := hp; exact ⟨c, hc, fun n hn => (h n hn).base⟩
    have haX : UA k (aX γ) := (UA.const k γ).mul (hx.mul hp)
    have haY : UA k (aY γ) := (UA.const k γ).mul ((hu.add mone).mul hp)
    refine ⟨?_, ?_, ?_⟩
    · refine UA.step hb0.1 ?_ ?_
      · exact (hu.add (mone.mul (hx.mul hx))).congr fun _ _ w _ => by rw [vfR_xiF_one]; ring
      · exact (hx.add (mone.mul (hx.mul hu))).congr fun _ _ w _ => by rw [vfR_xiF_I]; ring
    · refine UA.step hb0.2.1 ?_ ?_
      · exact (mone.mul (hx.mul hu)).congr fun _ _ w _ => by rw [vfR_upF_one]; ring
      · exact ((hu.add hu).add (mone.mul (hu.mul hu))).congr fun _ _ w _ => by rw [vfR_upF_I]; ring
    · refine UA.step hb0.2.2 ?_ ?_
      · exact ((hp.add mone).mul haX).congr fun n hn w hw => (vfR_pN_one γ n hn hw).symm
      · exact ((hp.add mone).mul haY).congr fun n hn w hw => (vfR_pN_I γ n hn hw).symm

lemma UA_aX (γ : ℝ) (k : ℕ) : UA k (aX γ) := by
  obtain ⟨hx, -, hp⟩ := gens_A γ k
  exact (UA.const k γ).mul (hx.mul hp)

lemma UA_aY (γ : ℝ) (k : ℕ) : UA k (aY γ) := by
  obtain ⟨-, hu, hp⟩ := gens_A γ k
  exact (UA.const k γ).mul ((hu.add (UA.const k (-1))).mul hp)

/-- `F = W^j Q`, `Q` uniformly bounded with `k` derivatives. -/
def RelW (γ : ℝ) (j k : ℕ) (F : ℕ → ℂ → ℝ) : Prop :=
  ∃ Q : ℕ → ℂ → ℝ, UA k Q ∧ ∀ n : ℕ, 0 < n → ∀ w : ℂ, 0 < w.im → F n w = Wn γ n w ^ j * Q n w

lemma vfR_pow_Wn (γ : ℝ) (n : ℕ) (hn : 0 < n) {w : ℂ} (hw : 0 < w.im) (v : ℂ) {a : ℝ} (hv : vfR v (Wn γ n) w = Wn γ n w * a) (j : ℕ) :
    vfR v (fun u => Wn γ n u ^ j) w = (j : ℝ) * Wn γ n w ^ j * a := by
  have hd : DifferentiableAt ℝ (Wn γ n) w := (contDiffAt_Wn γ n hn hw).differentiableAt (by simp)
  induction j with
  | zero => simp [vfR]
  | succ j ih =>
    have hdj : DifferentiableAt ℝ (fun u => Wn γ n u ^ j) w := hd.pow j
    have e : (fun u => Wn γ n u ^ (j + 1)) = fun u => Wn γ n u ^ j * Wn γ n u := by funext u; rw [pow_succ]
    rw [e, Ak.vfR_mul_at hdj hd v, ih, hv]
    push_cast
    ring

namespace RelW

variable {γ : ℝ} {j k : ℕ} {F : ℕ → ℂ → ℝ}

lemma pred (h : RelW γ j (k + 1) F) : RelW γ j k F := by
  obtain ⟨Q, hQ, he⟩ := h
  exact ⟨Q, hQ.pred, he⟩

lemma vf_gen {a : ℕ → ℂ → ℝ} (ha : UA k a) (v : ℂ) (hvW : ∀ n : ℕ, 0 < n → ∀ w : ℂ, 0 < w.im → vfR v (Wn γ n) w = Wn γ n w * a n w)
    (hQv : ∀ {Q : ℕ → ℂ → ℝ}, UA (k + 1) Q → UA k fun n => vfR v (Q n)) (h : RelW γ j (k + 1) F) :
    RelW γ j k fun n => vfR v (F n) := by
  obtain ⟨Q, hQ, he⟩ := h
  refine ⟨fun n u => (j : ℝ) * (a n u * Q n u) + vfR v (Q n) u, ((UA.const k (j : ℝ)).mul (ha.mul hQ.pred)).add (hQv hQ), fun n hn w hw => ?_⟩
  have hev : F n =ᶠ[𝓝 w] fun u => Wn γ n u ^ j * Q n u := (ev_up hw).mono fun u hu => he n hn u hu
  obtain ⟨c, _, hc⟩ := hQ
  have hdQ : DifferentiableAt ℝ (Q n) w := (hc n hn).diff hw
  have hd : DifferentiableAt ℝ (Wn γ n) w := (contDiffAt_Wn γ n hn hw).differentiableAt (by simp)
  show vfR v (F n) w = Wn γ n w ^ j * ((j : ℝ) * (a n w * Q n w) + vfR v (Q n) w)
  have hdj : DifferentiableAt ℝ (fun u => Wn γ n u ^ j) w := hd.pow j
  rw [vfR_congr hev, Ak.vfR_mul_at hdj hdQ v, vfR_pow_Wn γ n hn hw v (hvW n hn w hw) j]
  ring

lemma vf_X (h : RelW γ j (k + 1) F) : RelW γ j k fun n => vfR 1 (F n) :=
  vf_gen (UA_aX γ k) 1 (fun n hn w hw => vfR_Wn_one γ n hn hw) (fun hQ => hQ.xs) h

lemma vf_Y (h : RelW γ j (k + 1) F) : RelW γ j k fun n => vfR Complex.I (F n) :=
  vf_gen (UA_aY γ k) Complex.I (fun n hn w hw => vfR_Wn_I γ n hn hw) (fun hQ => hQ.ys) h

lemma div (h : RelW γ (j + 1) k F) : RelW γ j k fun n w => F n w / Wn γ n w := by
  obtain ⟨Q, hQ, he⟩ := h
  refine ⟨Q, hQ, fun n hn w hw => ?_⟩
  have := (Wn_pos γ n hn hw).ne'
  show F n w / Wn γ n w = Wn γ n w ^ j * Q n w
  rw [he n hn w hw, pow_succ]
  field_simp

/-- The pointwise bound and smoothness. -/
lemma bound (h : RelW γ j k F) : ∃ c : ℝ, 0 ≤ c ∧ ∀ n : ℕ, 0 < n → ∀ w : ℂ, 0 < w.im →
    ContDiffAt ℝ ∞ (F n) w ∧ |F n w| ≤ c * Wn γ n w ^ j := by
  obtain ⟨Q, ⟨c, hc, hQ⟩, he⟩ := h
  refine ⟨c, hc, fun n hn w hw => ⟨?_, ?_⟩⟩
  · have h1 : ContDiffAt ℝ ∞ (fun u => Wn γ n u ^ j * Q n u) w := ((contDiffAt_Wn γ n hn hw).pow j).mul ((hQ n hn).smooth w hw)
    exact h1.congr_of_eventuallyEq ((ev_up hw).mono fun u hu => he n hn u hu)
  · rw [he n hn w hw, abs_mul, abs_of_nonneg (pow_nonneg (Wn_pos γ n hn hw).le j), mul_comm]
    exact mul_le_mul_of_nonneg_right ((hQ n hn).bd w hw) (pow_nonneg (Wn_pos γ n hn hw).le j)

lemma pow_le_n (γ : ℝ) (j n : ℕ) (hn : 0 < n) {w : ℂ} (hw : 0 < w.im) : Wn γ n w ^ j ≤ (n : ℝ) ^ j :=
  pow_le_pow_left₀ (Wn_pos γ n hn hw).le (Wn_le γ n hn hw) j

/-- `Adm` from two derivatives. -/
lemma adm (h : RelW γ j 2 F) : ∃ c : ℝ, 0 ≤ c ∧ ∀ n : ℕ, 0 < n → Adm (F n) (c * (n : ℝ) ^ j) := by
  obtain ⟨c0, hc0, b0⟩ := h.bound
  have hX := h.vf_X
  have hY := h.vf_Y
  obtain ⟨c1, hc1, b1⟩ := hX.bound
  obtain ⟨c2, hc2, b2⟩ := hY.bound
  obtain ⟨c3, hc3, b3⟩ := hX.vf_X.bound
  obtain ⟨c4, hc4, b4⟩ := hY.vf_Y.bound
  refine ⟨c0 + c1 + c2 + c3 + c4, by positivity, fun n hn => ⟨fun w hw => (b0 n hn w hw).1, fun w hw => ?_, fun w hw => ?_, fun w hw => ?_, fun w hw => ?_⟩⟩
  · have hn' := pow_le_n γ j n hn hw
    have hp : (0 : ℝ) ≤ (n : ℝ) ^ j := by positivity
    calc |F n w| ≤ c0 * Wn γ n w ^ j := (b0 n hn w hw).2
      _ ≤ c0 * (n : ℝ) ^ j := mul_le_mul_of_nonneg_left hn' hc0
      _ ≤ _ := mul_le_mul_of_nonneg_right (by linarith) hp
  · have hn' := pow_le_n γ j n hn hw
    have hp : (0 : ℝ) ≤ (n : ℝ) ^ j := by positivity
    calc |vfR 1 (F n) w| ≤ c1 * Wn γ n w ^ j := (b1 n hn w hw).2
      _ ≤ c1 * (n : ℝ) ^ j := mul_le_mul_of_nonneg_left hn' hc1
      _ ≤ _ := mul_le_mul_of_nonneg_right (by linarith) hp
  · have hn' := pow_le_n γ j n hn hw
    have hp : (0 : ℝ) ≤ (n : ℝ) ^ j := by positivity
    calc |vfR Complex.I (F n) w| ≤ c2 * Wn γ n w ^ j := (b2 n hn w hw).2
      _ ≤ c2 * (n : ℝ) ^ j := mul_le_mul_of_nonneg_left hn' hc2
      _ ≤ _ := mul_le_mul_of_nonneg_right (by linarith) hp
  · have hn' := pow_le_n γ j n hn hw
    have hp : (0 : ℝ) ≤ (n : ℝ) ^ j := by positivity
    have t1 := (b3 n hn w hw).2
    have t2 := (b4 n hn w hw).2
    have t3 := (b2 n hn w hw).2
    have hW0 : 0 ≤ Wn γ n w ^ j := pow_nonneg (Wn_pos γ n hn hw).le j
    unfold lapRv
    calc |vfR 1 (vfR 1 (F n)) w + vfR Complex.I (vfR Complex.I (F n)) w - vfR Complex.I (F n) w|
        ≤ |vfR 1 (vfR 1 (F n)) w| + |vfR Complex.I (vfR Complex.I (F n)) w| + |vfR Complex.I (F n) w| :=
          (abs_sub _ _).trans (add_le_add (abs_add_le _ _) le_rfl)
      _ ≤ (c3 + c4 + c2) * Wn γ n w ^ j := by nlinarith
      _ ≤ (c3 + c4 + c2) * (n : ℝ) ^ j := mul_le_mul_of_nonneg_left hn' (by positivity)
      _ ≤ _ := mul_le_mul_of_nonneg_right (by linarith) hp

end RelW

lemma SB_mono {g : ℂ → ℝ} {C D : ℝ} (hCD : C ≤ D) (h : SB g C) : SB g D := ⟨h.s, fun w hw => (h.b w hw).trans hCD⟩

lemma Adm_mono {g : ℂ → ℝ} {C D : ℝ} (hCD : C ≤ D) (h : Adm g C) : Adm g D :=
  ⟨h.s, fun w hw => (h.b0 w hw).trans hCD, fun w hw => (h.bX w hw).trans hCD, fun w hw => (h.bY w hw).trans hCD, fun w hw => (h.bL w hw).trans hCD⟩

lemma abs_aX_le (γ : ℝ) (hγ : 0 ≤ γ) (n : ℕ) (hn : 0 < n) {w : ℂ} (hw : 0 < w.im) : |aX γ n w| ≤ γ := by
  unfold aX
  rw [abs_mul, abs_mul, abs_of_nonneg hγ, abs_of_pos (pN_pos γ n hn hw)]
  have h1 := abs_xiF_le w
  have h2 := pN_le γ n hn hw
  have h3 := (pN_pos γ n hn hw).le
  calc γ * (|xiF w| * pN γ n w) ≤ γ * (1 * 1) := by gcongr
    _ = γ := by ring

lemma abs_aY_le (γ : ℝ) (hγ : 0 ≤ γ) (n : ℕ) (hn : 0 < n) {w : ℂ} (hw : 0 < w.im) : |aY γ n w| ≤ γ := by
  unfold aY
  rw [abs_mul, abs_mul, abs_of_nonneg hγ, abs_of_pos (pN_pos γ n hn hw)]
  have h1 : |upF w + -1| ≤ 1 := by
    rw [abs_le]
    constructor <;> linarith [upF_nonneg w, upF_le_two w]
  have h2 := pN_le γ n hn hw
  have h3 := (pN_pos γ n hn hw).le
  calc γ * (|upF w + -1| * pN γ n w) ≤ γ * (1 * 1) := by gcongr
    _ = γ := by ring

/-- **`W_n` is admissible with `ρ = γ` and `K` independent of `n`.** -/
theorem waveW3_Wn {γ : ℝ} (hγ : 0 ≤ γ) : ∃ K : ℝ, 0 ≤ K ∧ ∀ n : ℕ, 0 < n → ∃ C : ℝ, WaveW3 (Wn γ n) C γ K := by
  have hW1 : RelW γ 1 3 (Wn γ) := ⟨fun _ _ => 1, UA.const 3 1, fun n _ w _ => by simp⟩
  have hH : RelW γ 2 3 (fun n u => Wn γ n u ^ 2) := ⟨fun _ _ => 1, UA.const 3 1, fun n _ w _ => by simp⟩
  have HX := hH.vf_X
  have HY := hH.vf_Y
  have HXX := HX.vf_X
  have HYY := HY.vf_Y
  have WX := hW1.vf_X
  have WY := hW1.vf_Y
  have WXX := WX.vf_X
  have WYY := WY.vf_Y
  obtain ⟨c1, hc1, a1⟩ := hH.pred.adm
  obtain ⟨c2, hc2, a2⟩ := HX.adm
  obtain ⟨c3, hc3, a3⟩ := HY.adm
  obtain ⟨c4, hc4, a4⟩ := hW1.pred.adm
  obtain ⟨c5, hc5, a5⟩ := WX.adm
  obtain ⟨c6, hc6, a6⟩ := WY.adm
  obtain ⟨d1, hd1, b1⟩ := HX.div.bound
  obtain ⟨d2, hd2, b2⟩ := HY.div.bound
  obtain ⟨d3, hd3, b3⟩ := HXX.div.bound
  obtain ⟨d4, hd4, b4⟩ := HYY.div.bound
  obtain ⟨e1, he1, r1⟩ := WXX.bound
  obtain ⟨e2, he2, r2⟩ := WYY.bound
  obtain ⟨e3, he3, r3⟩ := WY.bound
  refine ⟨d3 + d4 + e1 + e2 + e3, by positivity, fun n hn => ?_⟩
  set S := c1 + c2 + c3 + c4 + c5 + c6 + d1 + d2 + d3 + d4 + 1 with hS
  have hS0 : 0 ≤ S := by positivity
  have hN0 : (0 : ℝ) < n := by exact_mod_cast hn
  have hN1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  set Nn : ℝ := (n : ℝ) ^ 2 + n + 1 with hNn
  have h1N : (n : ℝ) ^ 1 ≤ Nn := by rw [pow_one, hNn]; nlinarith [sq_nonneg (n : ℝ)]
  have h2N : (n : ℝ) ^ 2 ≤ Nn := by rw [hNn]; linarith
  have hNp : 0 ≤ Nn := by positivity
  have lift : ∀ {c : ℝ} {j : ℕ}, 0 ≤ c → c ≤ S → (n : ℝ) ^ j ≤ Nn → c * (n : ℝ) ^ j ≤ S * Nn := fun {c j} hc hcS hj =>
    mul_le_mul hcS hj (by positivity) hS0
  have sbOf : ∀ {g : ℂ → ℝ} {d : ℝ}, 0 ≤ d → d ≤ S → (∀ w : ℂ, 0 < w.im → ContDiffAt ℝ ∞ g w ∧ |g w| ≤ d * Wn γ n w ^ 1) → SB g (S * Nn) := fun {g d} hd hdS h =>
    ⟨fun w hw => (h w hw).1, fun w hw => (h w hw).2.trans (by
      have hp := RelW.pow_le_n γ 1 n hn hw
      exact (mul_le_mul_of_nonneg_left hp hd).trans (lift hd hdS h1N))⟩
  have hexpand : S = c1 + c2 + c3 + c4 + c5 + c6 + d1 + d2 + d3 + d4 + 1 := hS
  refine ⟨S * Nn, ?_⟩
  exact
  { pos := fun w hw => Wn_pos γ n hn hw
    sb := SB_mono (lift hc4 (by linarith) h1N) (a4 n hn).sb
    adm := Adm_mono (lift hc1 (by linarith) h2N) (a1 n hn)
    mX := sbOf hd1 (by linarith) (b1 n hn)
    mY := sbOf hd2 (by linarith) (b2 n hn)
    bX := fun w hw => by
      have e := vfR_pow_Wn γ n hn hw 1 (vfR_Wn_one γ n hn hw) 2
      have hp := Wn_pos γ n hn hw
      rw [e]
      have e2 : ((2 : ℕ) : ℝ) * Wn γ n w ^ 2 * aX γ n w / Wn γ n w = 2 * Wn γ n w * aX γ n w := by
        push_cast; field_simp
      rw [e2, abs_mul, abs_mul, abs_of_pos hp]
      have := abs_aX_le γ hγ n hn hw
      norm_num
      nlinarith [mul_le_mul_of_nonneg_left this hp.le]
    bY := fun w hw => by
      have e := vfR_pow_Wn γ n hn hw Complex.I (vfR_Wn_I γ n hn hw) 2
      have hp := Wn_pos γ n hn hw
      rw [e]
      have e2 : ((2 : ℕ) : ℝ) * Wn γ n w ^ 2 * aY γ n w / Wn γ n w = 2 * Wn γ n w * aY γ n w := by
        push_cast; field_simp
      rw [e2, abs_mul, abs_mul, abs_of_pos hp]
      have := abs_aY_le γ hγ n hn hw
      norm_num
      nlinarith [mul_le_mul_of_nonneg_left this hp.le]
    ρ0 := hγ
    admX := Adm_mono (lift hc2 (by linarith) h2N) (a2 n hn)
    admY := Adm_mono (lift hc3 (by linarith) h2N) (a3 n hn)
    mXX := sbOf hd3 (by linarith) (b3 n hn)
    mYY := sbOf hd4 (by linarith) (b4 n hn)
    bXX := fun w hw => by
      have h := (b3 n hn w hw).2
      rw [pow_one] at h
      have hp := (Wn_pos γ n hn hw).le
      refine h.trans (mul_le_mul_of_nonneg_right ?_ hp)
      linarith
    bYY := fun w hw => by
      have h := (b4 n hn w hw).2
      rw [pow_one] at h
      have hp := (Wn_pos γ n hn hw).le
      refine h.trans (mul_le_mul_of_nonneg_right ?_ hp)
      linarith
    K0 := by positivity
    admW := Adm_mono (lift hc4 (by linarith) h1N) (a4 n hn)
    admXW := Adm_mono (lift hc5 (by linarith) h1N) (a5 n hn)
    admYW := Adm_mono (lift hc6 (by linarith) h1N) (a6 n hn)
    rX := fun w hw => by
      have hp := Wn_pos γ n hn hw
      rw [vfR_Wn_one γ n hn hw, abs_mul, abs_of_pos hp, mul_comm]
      exact mul_le_mul_of_nonneg_right (abs_aX_le γ hγ n hn hw) hp.le
    rY := fun w hw => by
      have hp := Wn_pos γ n hn hw
      rw [vfR_Wn_I γ n hn hw, abs_mul, abs_of_pos hp, mul_comm]
      exact mul_le_mul_of_nonneg_right (abs_aY_le γ hγ n hn hw) hp.le
    rXX := fun w hw => by
      have h := (r1 n hn w hw).2
      rw [pow_one] at h
      have hp := (Wn_pos γ n hn hw).le
      exact h.trans (mul_le_mul_of_nonneg_right (by linarith) hp)
    rYY := fun w hw => by
      have h := (r2 n hn w hw).2
      rw [pow_one] at h
      have hp := (Wn_pos γ n hn hw).le
      exact h.trans (mul_le_mul_of_nonneg_right (by linarith) hp)
    rL := fun w hw => by
      have h1 := (r1 n hn w hw).2
      have h2 := (r2 n hn w hw).2
      have h3 := (r3 n hn w hw).2
      rw [pow_one] at h1 h2 h3
      have hp := (Wn_pos γ n hn hw).le
      unfold lapRv
      calc |vfR 1 (vfR 1 (Wn γ n)) w + vfR Complex.I (vfR Complex.I (Wn γ n)) w - vfR Complex.I (Wn γ n) w|
          ≤ |vfR 1 (vfR 1 (Wn γ n)) w| + |vfR Complex.I (vfR Complex.I (Wn γ n)) w| + |vfR Complex.I (Wn γ n) w| :=
            (abs_sub _ _).trans (add_le_add (abs_add_le _ _) le_rfl)
        _ ≤ (e1 + e2 + e3) * Wn γ n w := by nlinarith
        _ ≤ _ := mul_le_mul_of_nonneg_right (by linarith) hp }

/-! ### The limit `n → ∞` -/

section limit

open scoped ENNReal UpperHalfPlane

local notation "L2H'" => Lp ℂ 2 (volume : Measure UpperHalfPlane)

/-- `‖W f‖²` as a lower integral. -/
lemma lint_W {g : ℂ → ℝ} {C : ℝ} (H : SB g C) (hpos : ∀ w : ℂ, 0 < w.im → 0 < g w) (f : L2H') :
    ∫⁻ z : ℍ, (ENNReal.ofReal (g (z : ℂ)) * ‖f z‖ₑ) ^ 2 = ENNReal.ofReal (‖mulCL H f‖ ^ 2) := by
  rw [← lintegral_enorm_sq_eq]
  refine lintegral_congr_ae ?_
  filter_upwards [coe_mulCL H f] with z hz
  have e : ‖((g (z : ℂ) : ℝ) : ℂ)‖ₑ = ENNReal.ofReal (g (z : ℂ)) := by
    rw [← ofReal_norm_eq_enorm, Complex.norm_real, Real.norm_of_nonneg (hpos _ z.im_pos).le]
  rw [hz, enorm_mul, e]

lemma Wn_le_lim (γ : ℝ) (n : ℕ) (hn : 0 < n) {w : ℂ} (hw : 0 < w.im) : Wn γ n w ≤ (tauG γ w)⁻¹ := by
  have h1 := tauG_pos γ hw
  have h2 := inv_n_pos n hn
  exact inv_anti₀ h1 (by linarith)

lemma tendsto_Wn (γ : ℝ) {w : ℂ} (hw : 0 < w.im) : Tendsto (fun n : ℕ => Wn γ (n + 1) w) atTop (𝓝 (tauG γ w)⁻¹) := by
  have h1 := tauG_pos γ hw
  have h0 : Tendsto (fun n : ℕ => (((n + 1 : ℕ) : ℝ))⁻¹) atTop (𝓝 0) := by
    have := tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)
    refine this.congr fun n => ?_
    push_cast
    rw [one_div]
  have h2 : Tendsto (fun n : ℕ => tauG γ w + (((n + 1 : ℕ) : ℝ))⁻¹) atTop (𝓝 (tauG γ w + 0)) := tendsto_const_nhds.add h0
  rw [add_zero] at h2
  exact h2.inv₀ h1.ne'

lemma inv_tauG_eq (γ : ℝ) (z : ℍ) : (tauG γ (z : ℂ))⁻¹ = coshD UpperHalfPlane.I z ^ γ := by
  have hc : 0 < coshD UpperHalfPlane.I z := Real.cosh_pos _
  rw [tauG, hF_eq_inv_coshD, Real.inv_rpow hc.le, inv_inv]

lemma measurable_Wn_coe (γ : ℝ) (n : ℕ) (hn : 0 < n) : Measurable fun z : ℍ => Wn γ n (z : ℂ) := by
  have : Continuous fun z : ℍ => Wn γ n (z : ℂ) :=
    continuous_iff_continuousAt.2 fun z =>
      ((contDiffAt_Wn γ n hn z.im_pos).continuousAt).comp UpperHalfPlane.continuous_coe.continuousAt
  exact this.measurable

/-- **Proposition WS, `k = 0`, for the weight `X₀^γ`.** The constant `G` does not depend on `ε`. -/
theorem ws0_cosh (P : MollProfile) {γ : ℝ} (hγ : 0 ≤ γ) :
    ∃ G : ℝ, 0 ≤ G ∧ ∀ {ε : ℝ} (hε : 0 < ε), ε ≤ 1 → ∀ (hb : ℝ) {s₀ s₁ : ℝ}, 0 ≤ s₀ → 0 ≤ s₁ → ∀ a : L2H',
      ∫⁻ z : ℍ, (ENNReal.ofReal (coshD UpperHalfPlane.I z ^ γ)
          * ‖((P.cutoffEps hε).flowEps hb s₁ (ContinuousLinearMap.adjoint ((P.cutoffEps hε).flowEps hb s₀) a) : L2H') z‖ₑ) ^ 2
        ≤ ENNReal.ofReal (Real.exp (|hb| * (ε⁻¹ * G) * |s₁ - s₀|))
          * ∫⁻ z : ℍ, (ENNReal.ofReal (coshD UpperHalfPlane.I z ^ γ) * ‖a z‖ₑ) ^ 2 := by
  obtain ⟨K, hK, hW⟩ := waveW3_Wn hγ
  refine ⟨genC P γ K, ?_, fun {ε} hε hε1 hb s₀ s₁ h0 h1 a => ?_⟩
  · obtain ⟨C, hC⟩ := hW 1 one_pos
    exact genC_nonneg P one_pos le_rfl hC
  set V : L2H' := (P.cutoffEps hε).flowEps hb s₁ (ContinuousLinearMap.adjoint ((P.cutoffEps hε).flowEps hb s₀) a) with hV
  set T := |hb| * (ε⁻¹ * genC P γ K) * |s₁ - s₀| with hT
  have hlev : ∀ n : ℕ, ∫⁻ z : ℍ, (ENNReal.ofReal (Wn γ (n + 1) (z : ℂ)) * ‖V z‖ₑ) ^ 2
      ≤ ENNReal.ofReal (Real.exp T) * ∫⁻ z : ℍ, (ENNReal.ofReal (coshD UpperHalfPlane.I z ^ γ) * ‖a z‖ₑ) ^ 2 := fun n => by
    obtain ⟨C, hC⟩ := hW (n + 1) n.succ_pos
    have key := ws0_trunc P hε hε1 hC hb h0 h1 a
    have hpos := hC.pos
    rw [lint_W hC.sb hpos V]
    have hsq : ‖mulCL hC.sb V‖ ^ 2 ≤ Real.exp T * ‖mulCL hC.sb a‖ ^ 2 := by
      have h2 := pow_le_pow_left₀ (norm_nonneg _) key 2
      rw [mul_pow, ← Real.exp_nat_mul] at h2
      have e : ((2 : ℕ) : ℝ) * (|hb| * (ε⁻¹ * genC P γ K) * |s₁ - s₀| / 2) = T := by rw [hT]; push_cast; ring
      rwa [e] at h2
    calc ENNReal.ofReal (‖mulCL hC.sb V‖ ^ 2) ≤ ENNReal.ofReal (Real.exp T * ‖mulCL hC.sb a‖ ^ 2) := ENNReal.ofReal_le_ofReal hsq
      _ = ENNReal.ofReal (Real.exp T) * ENNReal.ofReal (‖mulCL hC.sb a‖ ^ 2) := ENNReal.ofReal_mul (Real.exp_pos _).le
      _ ≤ _ := by
        rw [← lint_W hC.sb hpos a]
        gcongr with z
        rw [← inv_tauG_eq]
        exact Wn_le_lim γ (n + 1) n.succ_pos z.im_pos
  have hV2 : Measurable fun z : ℍ => ‖V z‖ₑ := (Lp.stronglyMeasurable V).measurable.enorm
  have hfatou : ∫⁻ z : ℍ, liminf (fun n : ℕ => (ENNReal.ofReal (Wn γ (n + 1) (z : ℂ)) * ‖V z‖ₑ) ^ 2) atTop
      ≤ liminf (fun n : ℕ => ∫⁻ z : ℍ, (ENNReal.ofReal (Wn γ (n + 1) (z : ℂ)) * ‖V z‖ₑ) ^ 2) atTop :=
    lintegral_liminf_le fun n => (((ENNReal.measurable_ofReal.comp (measurable_Wn_coe γ (n + 1) n.succ_pos)).mul hV2).pow_const 2)
  have hlim : ∀ z : ℍ, Tendsto (fun n : ℕ => (ENNReal.ofReal (Wn γ (n + 1) (z : ℂ)) * ‖V z‖ₑ) ^ 2) atTop
      (𝓝 ((ENNReal.ofReal (coshD UpperHalfPlane.I z ^ γ) * ‖V z‖ₑ) ^ 2)) := fun z => by
    have h1 := tendsto_Wn γ z.im_pos
    rw [inv_tauG_eq] at h1
    have h2 := ENNReal.continuous_ofReal.continuousAt.tendsto.comp h1
    have h3 := ENNReal.Tendsto.mul_const h2 (Or.inr (show ‖V z‖ₑ ≠ ⊤ from enorm_ne_top))
    exact ENNReal.Tendsto.pow h3
  calc ∫⁻ z : ℍ, (ENNReal.ofReal (coshD UpperHalfPlane.I z ^ γ) * ‖V z‖ₑ) ^ 2
      = ∫⁻ z : ℍ, liminf (fun n : ℕ => (ENNReal.ofReal (Wn γ (n + 1) (z : ℂ)) * ‖V z‖ₑ) ^ 2) atTop :=
        lintegral_congr fun z => (hlim z).liminf_eq.symm
    _ ≤ liminf (fun n : ℕ => ∫⁻ z : ℍ, (ENNReal.ofReal (Wn γ (n + 1) (z : ℂ)) * ‖V z‖ₑ) ^ 2) atTop := hfatou
    _ ≤ _ := liminf_le_of_frequently_le' (Eventually.of_forall hlev).frequently

end limit

end Qschubert
