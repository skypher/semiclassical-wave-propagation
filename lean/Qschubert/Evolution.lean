import Qschubert.Generator

/-!
# Unitary evolution generated by a self-adjoint operator

For any self-adjoint `A` on a complex Hilbert space `H`: `evol hA ħ t = e^{-iħtA/2}` (the bounded
spectral integral of `s ↦ e^{-iħts/2}`) is a unitary group (`evol_zero`, `evol_add`, `evol_adjoint`,
`norm_evol`), strongly continuous (`continuous_evol_apply`), with generator `-(iħ/2)A`
(`hasDerivAt_evol`), and it preserves `Dom A` and commutes with `A` (`A_evol`). These are the
results of `Qschubert/Propagator.lean` and `Qschubert/Generator.lean` for a general `A`; on `M`,
`propCLM Γ = evol (negLapMH_isSelfAdjoint Γ)` (`propCLM_eq_evol`), and on `ℍ` the same applies to
`negLapH`. The Duhamel formula (`duhamel_evol`) follows.
-/

namespace Qschubert

open MeasureTheory Complex Filter Topology Physicslib4.Spectral Physicslib4.Spectral.Unbounded
open scoped ENNReal InnerProductSpace MatrixGroups UpperHalfPlane

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  {A : H →ₗ.[ℂ] H} (hA : IsSelfAdjoint A)

/-- `e^{-iħtA/2}`. -/
noncomputable def evol (hbar t : ℝ) : H →L[ℂ] H := (spectralMeasure hA).integral (propFun hbar t)

lemma A_eq_pmapIntegral : A = pmapIntegral (spectralMeasure hA) (fun x : ℝ => (x : ℂ)) :=
  (functionalCalculus_id hA).symm

lemma A_domain_eq : A.domain = integralDomain (spectralMeasure hA) (fun x : ℝ => (x : ℂ)) :=
  congrArg LinearPMap.domain (A_eq_pmapIntegral hA)

theorem evol_zero (hbar : ℝ) : evol hA hbar 0 = 1 := by
  have : propFun hbar 0 = 1 := by funext s; simp [propFun]
  rw [evol, this, ProjectionValuedMeasure.integral_one]

theorem evol_add (hbar s t : ℝ) :
    evol hA hbar (s + t) = evol hA hbar s * evol hA hbar t := by
  have : propFun hbar (s + t) = propFun hbar s * propFun hbar t := by
    funext x
    simp only [propFun, Pi.mul_apply, ← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [evol, this, ProjectionValuedMeasure.integral_mul _ (propFun_mem hbar s) (propFun_mem hbar t)]
  rfl

theorem evol_adjoint (hbar t : ℝ) :
    ContinuousLinearMap.adjoint (evol hA hbar t) = evol hA hbar (-t) := by
  have : (fun x => (starRingEnd ℂ) (propFun hbar t x)) = propFun hbar (-t) := by
    funext x
    simp only [propFun, ← Complex.exp_conj, map_neg, map_mul, Complex.conj_I, Complex.conj_ofReal]
    congr 1
    push_cast
    ring
  rw [evol, ← ProjectionValuedMeasure.integral_conj _ (propFun_mem hbar t), this]
  rfl

theorem evol_adjoint_mul_self (hbar t : ℝ) :
    ContinuousLinearMap.adjoint (evol hA hbar t) * evol hA hbar t = 1 := by
  rw [evol_adjoint, ← evol_add, neg_add_cancel, evol_zero]

/-- `U_A(t)` is an isometry. -/
theorem norm_evol (hbar t : ℝ) (v : H) :
    ‖evol hA hbar t v‖ = ‖v‖ := by
  have h : ⟪evol hA hbar t v, evol hA hbar t v⟫_ℂ = ⟪v, v⟫_ℂ := by
    rw [← ContinuousLinearMap.adjoint_inner_right]
    rw [show ContinuousLinearMap.adjoint (evol hA hbar t) (evol hA hbar t v)
        = (ContinuousLinearMap.adjoint (evol hA hbar t) * evol hA hbar t) v from rfl,
      evol_adjoint_mul_self]
    rfl
  have h' := congrArg Complex.re h
  rw [inner_self_eq_norm_sq_to_K, inner_self_eq_norm_sq_to_K] at h'
  have h2 : ‖evol hA hbar t v‖ ^ 2 = ‖v‖ ^ 2 := by exact_mod_cast h'
  exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).1 h2

/-- `‖U(t)v - U(s)v‖² = ∫ |e^{-iħtx/2} - e^{-iħsx/2}|² dμ_v`. -/
lemma norm_sq_evol_sub (hbar t s : ℝ) (v : H) :
    ‖evol hA hbar t v - evol hA hbar s v‖ ^ 2
      = ∫ x, ‖propFun hbar t x - propFun hbar s x‖ ^ 2
          ∂((spectralMeasure (hA)).assoc v) := by
  set μ := spectralMeasure (hA)
  have hs' : (-1 : ℂ) • propFun hbar s ∈ BddMeasurable ℝ := (BddMeasurable ℝ).smul_mem _ (propFun_mem hbar s)
  have hsum : propFun hbar t + (-1 : ℂ) • propFun hbar s ∈ BddMeasurable ℝ :=
    (BddMeasurable ℝ).add_mem (propFun_mem hbar t) hs'
  have e : evol hA hbar t v - evol hA hbar s v
      = μ.integral (propFun hbar t + (-1 : ℂ) • propFun hbar s) v := by
    rw [ProjectionValuedMeasure.integral_add μ (propFun_mem hbar t) hs',
      ProjectionValuedMeasure.integral_smul μ _ (propFun_mem hbar s)]
    simp [evol, μ, sub_eq_add_neg]
  rw [e, Physicslib4.Spectral.Unbounded.norm_sq_integral_apply μ hsum]
  congr 1
  funext x
  simp [sub_eq_add_neg]

/-- **Strong continuity**: `t ↦ U_A(t) v` is continuous. -/
theorem continuous_evol_apply (hbar : ℝ) (v : H) :
    Continuous fun t => evol hA hbar t v := by
  set μ := spectralMeasure (hA)
  have hfin : IsFiniteMeasure (μ.assoc v) :=
    ⟨by rw [Physicslib4.Spectral.Unbounded.assoc_univ_eq μ v]; exact ENNReal.ofReal_lt_top⟩
  rw [continuous_iff_continuousAt]
  intro s
  rw [ContinuousAt, tendsto_iff_norm_sub_tendsto_zero]
  have hcont : ∀ x, Continuous fun t => propFun hbar t x := fun x => by
    unfold propFun; fun_prop
  have hint : Filter.Tendsto (fun t => ∫ x, ‖propFun hbar t x - propFun hbar s x‖ ^ 2 ∂(μ.assoc v))
      (nhds s) (nhds 0) := by
    have h0 : (0 : ℝ) = ∫ x, ‖propFun hbar s x - propFun hbar s x‖ ^ 2 ∂(μ.assoc v) := by simp
    rw [h0]
    refine MeasureTheory.tendsto_integral_filter_of_dominated_convergence (fun _ => (4 : ℝ)) ?_ ?_
      (integrable_const _) ?_
    · exact Filter.Eventually.of_forall fun t =>
        (Continuous.measurable (by unfold propFun; fun_prop)).aestronglyMeasurable
    · refine Filter.Eventually.of_forall fun t => Filter.Eventually.of_forall fun x => ?_
      have h1 : ‖propFun hbar t x - propFun hbar s x‖ ≤ 2 :=
        (norm_sub_le _ _).trans (by rw [norm_propFun, norm_propFun]; norm_num)
      rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      nlinarith [norm_nonneg (propFun hbar t x - propFun hbar s x)]
    · refine Filter.Eventually.of_forall fun x => ?_
      exact ((((hcont x).sub continuous_const).norm.pow 2).tendsto s)
  have hsq : Filter.Tendsto (fun t => ‖evol hA hbar t v - evol hA hbar s v‖ ^ 2)
      (nhds s) (nhds 0) := by
    simp_rw [norm_sq_evol_sub]
    exact hint
  have := (Real.continuous_sqrt.tendsto 0).comp hsq
  simp only [Function.comp_def, Real.sqrt_zero] at this
  refine this.congr fun t => ?_
  rw [Real.sqrt_sq (norm_nonneg _)]

lemma slope_eq_integral_evol (hbar h : ℝ) (v : H) :
    h⁻¹ • (evol hA hbar h v - v) = (spectralMeasure (hA)).integral (diffQ hbar h) v := by
  set μ := spectralMeasure (hA)
  have h1 : (fun x => propFun hbar h x - 1) ∈ BddMeasurable ℝ :=
    (BddMeasurable ℝ).sub_mem (propFun_mem hbar h) ⟨measurable_const, 1, fun _ => by simp⟩
  have e1 : diffQ hbar h = ((h : ℂ))⁻¹ • (fun x => propFun hbar h x - 1) := by
    funext x; simp [diffQ]
  have e2 : (fun x => propFun hbar h x - 1) = propFun hbar h + (-1 : ℂ) • (1 : ℝ → ℂ) := by
    funext x; simp [sub_eq_add_neg]
  have h1' : (1 : ℝ → ℂ) ∈ BddMeasurable ℝ := ⟨measurable_const, 1, fun _ => by simp⟩
  rw [e1, ProjectionValuedMeasure.integral_smul μ _ h1, e2,
    ProjectionValuedMeasure.integral_add μ (propFun_mem hbar h) ((BddMeasurable ℝ).smul_mem _ h1'),
    ProjectionValuedMeasure.integral_smul μ _ h1', ProjectionValuedMeasure.integral_one]
  simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply, ContinuousLinearMap.one_apply]
  rw [show evol hA hbar h v = μ.integral (propFun hbar h) v from rfl, neg_one_smul, ← sub_eq_add_neg]
  rw [show ((h : ℂ))⁻¹ = ((h⁻¹ : ℝ) : ℂ) by push_cast; rfl, Complex.coe_smul]

/-- The generator at `0`: `h⁻¹(U(h)v - v) → c H v`, `c = -iħ/2`, for `v ∈ Dom H`. -/
theorem tendsto_slope_evol_zero (hbar : ℝ) (v : H)
    (hv : v ∈ (A).domain) :
    Tendsto (fun h : ℝ => h⁻¹ • (evol hA hbar h v - v)) (𝓝[≠] 0)
      (𝓝 ((-(I * (hbar : ℂ) / 2)) • A ⟨v, hv⟩)) := by
  set μ := spectralMeasure (hA)
  set c : ℂ := -(I * (hbar : ℂ) / 2) with hcdef
  have hid : Measurable fun x : ℝ => (x : ℂ) := Complex.measurable_ofReal
  have hv' : v ∈ integralDomain μ (fun x : ℝ => (x : ℂ)) := by
    have := hv; rw [A_eq_pmapIntegral hA] at this; exact this
  have hH : A ⟨v, hv⟩ = pmapIntegral μ (fun x : ℝ => (x : ℂ)) ⟨v, hv'⟩ := by
    have e := A_eq_pmapIntegral hA
    exact (LinearPMap.ext_iff.mp e).2 (x := v) (hf := hv) (hg := hv')
  rw [hH, tendsto_iff_norm_sub_tendsto_zero]
  simp_rw [slope_eq_integral_evol hA hbar, norm_sub_rev]
  have hsq : ∀ h : ℝ, ‖c • pmapIntegral μ (fun x : ℝ => (x : ℂ)) ⟨v, hv'⟩ - μ.integral (diffQ hbar h) v‖ ^ 2
      = ∫ x, ‖c * (x : ℂ) - diffQ hbar h x‖ ^ 2 ∂(μ.assoc v) := fun h =>
    norm_sq_smul_pmapIntegral_sub μ c hid (diffQ_mem hbar h) ⟨v, hv'⟩
  have hint : Integrable (fun x : ℝ => 4 * ‖c‖ ^ 2 * ‖(x : ℂ)‖ ^ 2) (μ.assoc v) :=
    (hv'.integrable_norm_pow two_ne_zero).const_mul _
  have hlim : Tendsto (fun h : ℝ => ∫ x, ‖c * (x : ℂ) - diffQ hbar h x‖ ^ 2 ∂(μ.assoc v)) (𝓝[≠] 0)
      (𝓝 0) := by
    suffices key : Tendsto (fun h : ℝ => ∫ x, ‖c * (x : ℂ) - diffQ hbar h x‖ ^ 2 ∂(μ.assoc v))
        (𝓝[≠] 0) (𝓝 (∫ x, (0 : ℝ) ∂(μ.assoc v))) by simpa using key
    refine tendsto_integral_filter_of_dominated_convergence (fun x => 4 * ‖c‖ ^ 2 * ‖(x : ℂ)‖ ^ 2) ?_ ?_ hint ?_
    · refine Eventually.of_forall fun h => ?_
      have : Measurable (diffQ hbar h) := (diffQ_mem hbar h).1
      exact (((hid.const_mul c).sub this).norm.pow_const 2).aestronglyMeasurable
    · refine eventually_mem_nhdsWithin.mono fun h hh => Eventually.of_forall fun x => ?_
      have hh0 : h ≠ 0 := hh
      have hq : ‖diffQ hbar h x‖ ≤ ‖c‖ * ‖(x : ℂ)‖ := by
        have hc : ‖c‖ = |hbar| / 2 := by
          rw [hcdef, norm_neg, norm_div, norm_mul, Complex.norm_I, Complex.norm_real, Real.norm_eq_abs]
          norm_num
        have he : propFun hbar h x - 1 = cexp (I * ((-(hbar * h * x / 2) : ℝ) : ℂ)) - 1 := by
          unfold propFun; congr 2; push_cast; ring
        have hb : ‖cexp (I * ((-(hbar * h * x / 2) : ℝ) : ℂ)) - 1‖ ≤ ‖(-(hbar * h * x / 2) : ℝ)‖ :=
          Real.norm_exp_I_mul_ofReal_sub_one_le
        have hpos : 0 < |h| := abs_pos.2 hh0
        unfold diffQ
        rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, he, hc, Complex.norm_real,
          Real.norm_eq_abs, inv_mul_le_iff₀ hpos]
        rw [Real.norm_eq_abs, abs_neg, abs_div, abs_mul, abs_mul] at hb
        calc ‖cexp (I * ((-(hbar * h * x / 2) : ℝ) : ℂ)) - 1‖ ≤ |hbar| * |h| * |x| / |2| := hb
          _ = |h| * (|hbar| / 2 * |x|) := by rw [abs_two]; ring
      have h2 : ‖c * (x : ℂ) - diffQ hbar h x‖ ≤ 2 * (‖c‖ * ‖(x : ℂ)‖) := by
        calc ‖c * (x : ℂ) - diffQ hbar h x‖ ≤ ‖c * (x : ℂ)‖ + ‖diffQ hbar h x‖ := norm_sub_le _ _
          _ ≤ 2 * (‖c‖ * ‖(x : ℂ)‖) := by rw [norm_mul]; linarith
      rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      calc ‖c * (x : ℂ) - diffQ hbar h x‖ ^ 2 ≤ (2 * (‖c‖ * ‖(x : ℂ)‖)) ^ 2 :=
            pow_le_pow_left₀ (norm_nonneg _) h2 2
        _ = 4 * ‖c‖ ^ 2 * ‖(x : ℂ)‖ ^ 2 := by ring
    · refine Eventually.of_forall fun x => ?_
      have hd : HasDerivAt (fun h : ℝ => propFun hbar h x) (c * (x : ℂ)) 0 := by
        have e : (fun h : ℝ => propFun hbar h x) = fun h : ℝ => cexp ((h : ℂ) * (c * (x : ℂ))) := by
          funext h; unfold propFun; congr 1; rw [hcdef]; push_cast; ring
        rw [e]
        have h1 : HasDerivAt (fun h : ℝ => (h : ℂ) * (c * (x : ℂ))) (1 * (c * (x : ℂ))) 0 :=
          (hasDerivAt_id (0 : ℝ)).ofReal_comp.mul_const _
        have h2 := h1.cexp
        simpa using h2
      rw [hasDerivAt_iff_tendsto_slope_zero] at hd
      have hd' : Tendsto (fun h : ℝ => diffQ hbar h x) (𝓝[≠] 0) (𝓝 (c * (x : ℂ))) := by
        refine hd.congr fun h => ?_
        simp only [zero_add, diffQ]
        rw [show propFun hbar 0 x = 1 by simp [propFun], Complex.real_smul]
        push_cast; rfl
      have := ((tendsto_const_nhds (x := c * (x : ℂ))).sub hd').norm.pow 2
      simpa using this
  have hsq' : Tendsto (fun h : ℝ => ‖c • pmapIntegral μ (fun x : ℝ => (x : ℂ)) ⟨v, hv'⟩
      - μ.integral (diffQ hbar h) v‖ ^ 2) (𝓝[≠] 0) (𝓝 0) := by
    simp_rw [hsq]; exact hlim
  have := (Real.continuous_sqrt.tendsto 0).comp hsq'
  simp only [Function.comp_def, Real.sqrt_zero] at this
  exact this.congr fun h => by rw [Real.sqrt_sq (norm_nonneg _)]

/-- **The generator of `U_A`**: for `v ∈ Dom(A)`, `d/dt U_A(t)v = -(iħ/2) U_A(t)(A v)`. -/
theorem hasDerivAt_evol (hbar t : ℝ) (v : H) (hv : v ∈ (A).domain) :
    HasDerivAt (fun s => evol hA hbar s v)
      ((-(I * (hbar : ℂ) / 2)) • evol hA hbar t (A ⟨v, hv⟩)) t := by
  rw [hasDerivAt_iff_tendsto_slope_zero]
  have h0 := tendsto_slope_evol_zero hA hbar v hv
  have hc := ((evol hA hbar t).continuous.tendsto _).comp h0
  rw [map_smul] at hc
  refine hc.congr fun h => ?_
  rw [Function.comp_apply, evol_add, ContinuousLinearMap.map_smul_of_tower, map_sub]
  rfl

/-- **`U_A(t)` preserves `Dom(A)` and commutes with `A`**. -/
theorem A_evol (hbar t : ℝ) (v : H) (hv : v ∈ (A).domain) :
    ∃ h : evol hA hbar t v ∈ (A).domain,
      A ⟨_, h⟩ = evol hA hbar t (A ⟨v, hv⟩) := by
  set μ := spectralMeasure (hA)
  set f : ℝ → ℂ := fun x => (x : ℂ)
  set g : ℝ → ℂ := propFun hbar t
  have hf : Measurable f := Complex.measurable_ofReal
  have hg : g ∈ BddMeasurable ℝ := propFun_mem hbar t
  have e := A_eq_pmapIntegral hA
  have hv' : v ∈ integralDomain μ f := by rw [← A_domain_eq hA]; exact hv
  have hgf : v ∈ integralDomain μ (g * f) := mem_integralDomain_mul_of_bdd μ hf hg hv'
  have hfg : v ∈ integralDomain μ (f * g) := by rw [mul_comm]; exact hgf
  have hmem : μ.integral g v ∈ integralDomain μ f := integral_apply_mem_of_mem μ hf hg hfg
  have hmem' : evol hA hbar t v ∈ (A).domain := by rw [A_domain_eq hA]; exact hmem
  refine ⟨hmem', ?_⟩
  have h1 : A ⟨_, hmem'⟩ = pmapIntegral μ f ⟨μ.integral g v, hmem⟩ :=
    (LinearPMap.ext_iff.mp e).2 (x := evol hA hbar t v) (hf := hmem') (hg := hmem)
  have h2 : A ⟨v, hv⟩ = pmapIntegral μ f ⟨v, hv'⟩ :=
    (LinearPMap.ext_iff.mp e).2 (x := v) (hf := hv) (hg := hv')
  rw [h1, h2, pmapIntegral_integral_apply_of_mem μ hf hg hfg]
  have h3 : μ.integral g (pmapIntegral μ f ⟨v, hv'⟩) = pmapIntegral μ (g * f) ⟨v, hgf⟩ :=
    integral_pmapIntegral_apply μ hf hg ⟨v, hv'⟩
  exact (pmapIntegral_congr_fun μ (mul_comm f g) v hfg hgf).trans h3.symm


lemma propCLM_eq_evol (Γ : Subgroup PGL(2, ℝ)) [ProperlyDiscontinuousSMul Γ ℍ] (hbar t : ℝ) :
    propCLM Γ hbar t = evol (negLapMH_isSelfAdjoint Γ) hbar t := rfl

/-- Joint continuity of `(τ, x) ↦ e^{-iħτA/2} x` along a filter. -/
lemma tendsto_evol_apply {α : Type*} {l : Filter α} {hbar τ₀ : ℝ} {x₀ : H} {φ : α → ℝ} {q : α → H}
    (hφ : Tendsto φ l (𝓝 τ₀)) (hq : Tendsto q l (𝓝 x₀)) :
    Tendsto (fun a => evol hA hbar (φ a) (q a)) l (𝓝 (evol hA hbar τ₀ x₀)) := by
  rw [tendsto_iff_norm_sub_tendsto_zero] at hq ⊢
  have h2 : Tendsto (fun a => ‖evol hA hbar (φ a) x₀ - evol hA hbar τ₀ x₀‖) l (𝓝 0) := by
    have := ((continuous_evol_apply hA hbar x₀).tendsto τ₀).comp hφ
    rw [tendsto_iff_norm_sub_tendsto_zero] at this
    exact this
  refine squeeze_zero (fun a => norm_nonneg _) (fun a => ?_) (by simpa using hq.add h2)
  calc ‖evol hA hbar (φ a) (q a) - evol hA hbar τ₀ x₀‖
      = ‖evol hA hbar (φ a) (q a - x₀) + (evol hA hbar (φ a) x₀ - evol hA hbar τ₀ x₀)‖ := by
        rw [map_sub]; congr 1; abel
    _ ≤ ‖evol hA hbar (φ a) (q a - x₀)‖ + ‖evol hA hbar (φ a) x₀ - evol hA hbar τ₀ x₀‖ := norm_add_le _ _
    _ = ‖q a - x₀‖ + ‖evol hA hbar (φ a) x₀ - evol hA hbar τ₀ x₀‖ := by rw [norm_evol]

lemma continuous_evol_comp {hbar : ℝ} {φ : ℝ → ℝ} {q : ℝ → H} (hφ : Continuous φ) (hq : Continuous q) :
    Continuous fun s => evol hA hbar (φ s) (q s) :=
  continuous_iff_continuousAt.2 fun s => tendsto_evol_apply hA (hφ.tendsto s) (hq.tendsto s)

/-- The product rule: `d/ds e^{iħsA/2} w(s) = e^{iħsA/2}(w'(s) + (iħ/2) A w(s))`. -/
theorem hasDerivAt_evol_neg_comp (hbar : ℝ) {w : ℝ → H} {w' : H} {s : ℝ} (hw : HasDerivAt w w' s)
    (hdom : w s ∈ A.domain) :
    HasDerivAt (fun r => evol hA hbar (-r) (w r))
      (evol hA hbar (-s) (w' + (I * (hbar : ℂ) / 2) • A ⟨w s, hdom⟩)) s := by
  have hT2 : HasDerivAt (fun r => evol hA hbar (-r) (w s))
      (-((-(I * (hbar : ℂ) / 2)) • evol hA hbar (-s) (A ⟨w s, hdom⟩))) s := by
    have h := hasDerivAt_evol hA hbar (-s) (w s) hdom
    have hc := h.scomp s (hasDerivAt_neg s)
    simpa [Function.comp_def] using hc
  rw [hasDerivAt_iff_tendsto_slope_zero] at hw hT2 ⊢
  have hT1 : Tendsto (fun h : ℝ => evol hA hbar (-(s + h)) (h⁻¹ • (w (s + h) - w s))) (𝓝[≠] 0)
      (𝓝 (evol hA hbar (-s) w')) := by
    refine tendsto_evol_apply hA ?_ hw
    have : Tendsto (fun h : ℝ => -(s + h)) (𝓝 0) (𝓝 (-(s + 0))) :=
      ((continuous_const.add continuous_id).neg.tendsto 0)
    simpa using this.mono_left nhdsWithin_le_nhds
  have hsum := hT1.add hT2
  have e : evol hA hbar (-s) (w' + (I * (hbar : ℂ) / 2) • A ⟨w s, hdom⟩)
      = evol hA hbar (-s) w' + -((-(I * (hbar : ℂ) / 2)) • evol hA hbar (-s) (A ⟨w s, hdom⟩)) := by
    rw [map_add, map_smul, neg_smul, neg_neg]
  rw [e]
  refine hsum.congr fun h => ?_
  rw [ContinuousLinearMap.map_smul_of_tower, map_sub, ← smul_add]
  congr 1
  abel

/-- **Duhamel formula** for `e^{-iħtA/2}`: for a `C¹` path `w` in `Dom A` with `s ↦ A w(s)` continuous,
`e^{iħbA/2} w(b) - e^{iħaA/2} w(a) = ∫_a^b e^{iħsA/2}(w'(s) + (iħ/2) A w(s)) ds`. -/
theorem duhamel_evol (hbar a b : ℝ) {w w' : ℝ → H} (hw : ∀ s, HasDerivAt w (w' s) s)
    (hdom : ∀ s, w s ∈ A.domain) (hw'c : Continuous w') (hAc : Continuous fun s => A ⟨w s, hdom s⟩) :
    evol hA hbar (-b) (w b) - evol hA hbar (-a) (w a)
      = ∫ s in a..b, evol hA hbar (-s) (w' s + (I * (hbar : ℂ) / 2) • A ⟨w s, hdom s⟩) := by
  have hcont : Continuous fun s => evol hA hbar (-s) (w' s + (I * (hbar : ℂ) / 2) • A ⟨w s, hdom s⟩) :=
    continuous_evol_comp hA continuous_neg (hw'c.add (hAc.const_smul _))
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun s _ => hasDerivAt_evol_neg_comp hA hbar (hw s) (hdom s))
    (hcont.intervalIntegrable a b)]

end Qschubert
